# Godot
.godot/
*.import.tmp
export_presets.cfg.bak
/android/build/
# Godot Android build template (installed by CI / locally with --install-android-build-template)
game/android/
/build/
*.apk
*.aab
*.ipa

# Blender
*.blend1
*.blend2

# Signing material — never commit
*.keystore
*.jks
*.p12
*.mobileprovision
.env
.env.*

# OS / editors
.DS_Store
Thumbs.db
__pycache__/

# Godot generated translations (rebuilt on import)
*.translation

# Store plugins: added on the CI runner only by tools/store/add_store_plugins.py (pinned zips), never committed,
# so a build without billing cannot declare BILLING or link StoreKit by accident (docs/MONETIZATION.md)
game/addons/GodotGooglePlayBilling/
game/ios/plugins/
